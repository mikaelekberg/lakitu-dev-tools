{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
	"schedule": ["before 9am on monday"],
	"timezone": "Europe/Stockholm",
	"labels": ["dependencies"],
	"prHourlyLimit": 5,
	"prConcurrentLimit": 10,
	"lockFileMaintenance": {
		"enabled": true,
		"schedule": ["before 9am on monday"],
		"automerge": true,
		"platformAutomerge": false
	},
	"packageRules": [
		{
			"description": "Wait three days before updating npm packages",
			"matchDatasources": ["npm"],
			"minimumReleaseAge": "3 days",
			"platformAutomerge": false
		},
		{
			"description": "Auto-merge patch and minor dependency updates when CI passes",
			"matchDepTypes": ["dependencies"],
			"matchUpdateTypes": ["patch", "minor"],
			"automerge": true,
			"automergeType": "pr"
		},
		{
			"description": "Auto-merge patch and minor dev dependency updates when CI passes",
			"matchDepTypes": ["devDependencies"],
			"matchUpdateTypes": ["patch", "minor"],
			"automerge": true,
			"automergeType": "pr"
		},
		{
			"description": "Automerge routine GitHub Actions updates",
			"matchManagers": ["github-actions"],
			"matchUpdateTypes": ["patch", "minor", "pinDigest", "digest"],
			"automerge": true
		},
		{
			"description": "Group Svelte ecosystem packages",
			"groupName": "Svelte ecosystem",
			"matchPackageNames": ["svelte", "svelte-check", "@sveltejs/*"]
		},
		{
			"description": "Group TailwindCSS ecosystem packages",
			"groupName": "TailwindCSS ecosystem",
			"matchPackageNames": ["tailwindcss", "@tailwindcss/*", "daisyui", "autoprefixer", "postcss"]
		},
		{
			"description": "Group linting and formatting packages",
			"groupName": "Linting and formatting",
			"matchPackageNames": [
				"eslint",
				"eslint-*",
				"@eslint/*",
				"prettier",
				"prettier-*",
				"typescript-eslint",
				"@typescript-eslint/*"
			]
		},
		{
			"description": "Group TypeScript packages",
			"groupName": "TypeScript",
			"matchPackageNames": ["typescript", "@types/*"]
		},
		{
			"description": "Group font packages",
			"groupName": "Fonts",
			"matchPackageNames": ["@fontsource/*", "@fontsource-variable/*"]
		},
		{
			"description": "Group Vite and Svelte major upgrades together",
			"groupName": "Svelte + Vite major platform upgrade",
			"matchUpdateTypes": ["major"],
			"matchPackageNames": [
				"vite",
				"@sveltejs/vite-plugin-svelte",
				"@sveltejs/kit",
				"@sveltejs/adapter-cloudflare"
			],
			"automerge": false,
			"labels": ["dependencies", "breaking-change"]
		},
		{
			"description": "Keep TypeScript major PRs open but marked blocked",
			"matchPackageNames": ["typescript"],
			"matchUpdateTypes": ["major"],
			"automerge": false,
			"addLabels": ["blocked"]
		},
		{
			"description": "Do not automerge major updates",
			"matchUpdateTypes": ["major"],
			"automerge": false,
			"labels": ["dependencies", "breaking-change"]
		},
		{
			"description": "Review major upgrades and replacements manually",
			"matchUpdateTypes": ["major", "replacement"],
			"automerge": false
		},
		{
			"description": "Review pre-1.0 minor updates manually",
			"matchCurrentVersion": "/^0\\./",
			"matchUpdateTypes": ["minor"],
			"automerge": false
		}
	],
	"automergeType": "pr",
	"automergeStrategy": "squash",
	"platformAutomerge": true,
	"rebaseWhen": "behind-base-branch"
}
